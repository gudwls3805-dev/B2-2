# ------------------------------------------------------------------
# 이 파일을 복사해서 .env 파일을 만드세요.  (cp .env.example .env)
# .env 에 실제 키를 넣고, .env 는 절대 커밋/공유하지 마세요(.gitignore 에 포함됨).
# 실제 키 값은 README/결과물/코드 어디에도 직접 적지 마세요.
# ------------------------------------------------------------------

# 사용할 제공자 선택 (기본값: openai / kakao)
LLM_PROVIDER=openai        # openai | gemini
MAP_PROVIDER=kakao         # kakao  | naver

# --- LLM: OpenAI 를 쓸 경우 ---
OPENAI_API_KEY=YOUR_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini

# --- LLM: Google Gemini 를 쓸 경우 ---
# GOOGLE_API_KEY=YOUR_GEMINI_KEY
# GEMINI_MODEL=gemini-1.5-flash

# --- 지도: Kakao Local 을 쓸 경우 ---
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_KEY

# --- 지도: Naver Local Search 를 쓸 경우 ---
# NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
# NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
